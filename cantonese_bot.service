[Unit]
Description=Cantonese AI Tutor Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=notah-pi
WorkingDirectory=/home/notah-pi/CantoBot
Environment="PATH=/home/notah-pi/CantoBot/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/notah-pi/CantoBot/.venv/bin/python3 -m src.main
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
